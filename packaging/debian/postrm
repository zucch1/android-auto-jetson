#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Drop the removed USB rule from udev's in-memory set.
set -eu

case "$1" in
    remove|purge)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/udev ] && command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload || true
        fi
        ;;
esac
