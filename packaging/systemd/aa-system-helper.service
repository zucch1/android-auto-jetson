[Unit]
Description=Android Auto reference privileged system helper
Requires=dbus.service
After=dbus.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/aa-system-helper
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
StateDirectory=aa-system-helper
StateDirectoryMode=0700
ReadWritePaths=/var/lib/aa-system-helper
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=multi-user.target
