[Unit]
Description=Android Auto reference privileged system helper
Requires=dbus.service
After=dbus.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/aa-system-helper
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
# iw/nft use netlink administration; NM and BlueZ are accessed through D-Bus.
# Receiver authentication reads /proc/<receiver-pid>/exe across Unix UIDs.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_PTRACE
NoNewPrivileges=yes
LimitCORE=0
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# File I/O, Unix/netlink sockets, threads and posix_spawn/wait.
# nm/Commands.cpp uses memfd_create for bounded iw/nft stdin.
SystemCallFilter=@system-service memfd_create
SystemCallErrorNumber=EPERM
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
StateDirectory=aa-system-helper
StateDirectoryMode=0700
ReadWritePaths=/var/lib/aa-system-helper
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=multi-user.target
