<node name="/org/custom/AndroidAutoSystemHelper">
  <interface name="org.custom.AndroidAutoSystemHelper1">
    <annotation name="org.custom.Contract.SemVer" value="1.4.0"/>
    <method name="PollBootstrapV1">
      <arg name="consumer_generation" type="t" direction="in"/>
      <arg name="source" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="handoff_handle" type="t" direction="out"/>
      <arg name="bond_address" type="s" direction="out"/>
      <arg name="adapter_identity" type="s" direction="out"/>
      <arg name="local_failure" type="u" direction="out"/>
    </method>
    <method name="AuthorizeBootstrapV1">
      <arg name="consumer_generation" type="t" direction="in"/>
      <arg name="source" type="t" direction="in"/>
      <arg name="handoff_handle" type="t" direction="in"/>
      <arg name="allow" type="u" direction="in"/>
      <arg name="listener_ready" type="u" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="reserved" type="t" direction="out"/>
    </method>
    <method name="GetAPCredentialsV1">
      <arg name="consumer_generation" type="t" direction="in"/>
      <arg name="source" type="t" direction="in"/>
      <arg name="handoff_handle" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="reserved" type="t" direction="out"/>
      <arg name="ssid" type="s" direction="out"/>
      <arg name="password" type="s" direction="out"/>
      <arg name="bssid" type="s" direction="out"/>
      <arg name="receiver_ip" type="s" direction="out"/>
      <arg name="port" type="u" direction="out"/>
      <arg name="activation_generation" type="t" direction="out"/>
    </method>
    <method name="RevokeAP1">
      <arg name="phone_id" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="reserved" type="t" direction="out"/>
    </method>
    <method name="PollPeerV1">
      <arg name="error" type="u" direction="out"/>
      <arg name="observed_handle" type="t" direction="out"/>
      <arg name="bond_address" type="s" direction="out"/>
      <arg name="adapter_identity" type="s" direction="out"/>
    </method>
    <method name="BindPeerV1">
      <arg name="consumer_generation" type="t" direction="in"/>
      <arg name="request_source" type="t" direction="in"/>
      <arg name="observed_handle" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="reserved" type="t" direction="out"/>
    </method>
    <method name="ReconnectPeerV1">
      <arg name="observed_handle" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="state" type="t" direction="out"/>
    </method>
    <method name="RevokePeerV1">
      <arg name="removed_bond_address" type="s" direction="in"/>
      <arg name="removed_adapter_identity" type="s" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="reserved" type="t" direction="out"/>
    </method>
    <method name="Issue">
      <arg name="consumer_generation" type="t" direction="in"/>
      <arg name="confirmed_source" type="t" direction="in"/>
      <arg name="action" type="u" direction="in"/>
      <arg name="channel" type="u" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="grant" type="t" direction="out"/>
    </method>
    <method name="Execute">
      <arg name="action" type="u" direction="in"/>
      <arg name="channel" type="u" direction="in"/>
      <arg name="grant" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="state" type="t" direction="out"/>
    </method>
    <!-- Verification only: true after explicit comparison acceptance and an exact bonded snapshot. Records nothing. -->
    <method name="PairingBondConfirmedV1">
      <arg name="generation" type="t" direction="in"/>
      <arg name="request" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="bonded" type="t" direction="out"/>
    </method>
    <!-- Marks the verified bond provisional (not admitted, cleanup kept); called only after every receiver-side check passed. -->
    <method name="PairingBondAcknowledgedV1">
      <arg name="generation" type="t" direction="in"/>
      <arg name="request" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="reserved" type="t" direction="out"/>
    </method>
    <!-- Admits the provisional bond; called only after the receiver's durable trust write. -->
    <method name="PairingBondCommittedV1">
      <arg name="generation" type="t" direction="in"/>
      <arg name="request" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="reserved" type="t" direction="out"/>
    </method>
    <!-- Makes the helper's bond state match the receiver's approved wireless identities (the
         single authority, at most 256), durably and idempotently. Called at receiver start, on
         every helper incarnation change, and after an enrolment ends without a commit.
         admitted_info: low 32 bits, approved identities left unadmitted; bit 32, an open
         enrolment window was left to its own outcome. -->
    <method name="ReconcileBondsV1">
      <arg name="approved" type="a(ss)" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="admitted_info" type="t" direction="out"/>
    </method>
    <method name="GetPairingComparisonV1">
      <arg name="consumer_generation" type="t" direction="in"/>
      <arg name="request_source" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="challenge_id" type="t" direction="out"/>
      <arg name="comparison" type="u" direction="out"/>
      <arg name="bond_address" type="s" direction="out"/>
      <arg name="adapter_identity" type="s" direction="out"/>
    </method>
    <method name="RespondPairingComparisonV1">
      <arg name="consumer_generation" type="t" direction="in"/>
      <arg name="request_source" type="t" direction="in"/>
      <arg name="challenge_id" type="t" direction="in"/>
      <arg name="accept" type="u" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="reserved" type="t" direction="out"/>
    </method>
    <method name="Invalidate">
      <arg name="consumer_generation" type="t" direction="in"/>
      <arg name="confirmed_source" type="t" direction="in"/>
      <arg name="error" type="u" direction="out"/>
      <arg name="reserved" type="t" direction="out"/>
    </method>
  </interface>
</node>
