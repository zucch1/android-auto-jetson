if(NOT CMAKE_CROSSCOMPILING)
    add_executable(aa_wireless_recovery_test tests/wireless_recovery/recovery_test.cpp tests/trust/syscall_faults.cpp)
    target_link_libraries(aa_wireless_recovery_test PRIVATE aa_wireless_attested_test_only GTest::gtest_main PkgConfig::AA_GIO)
    target_compile_definitions(aa_wireless_recovery_test PRIVATE AA_HELPER_BUILD="${CMAKE_BINARY_DIR}" AA_HELPER_SOURCE="${CMAKE_SOURCE_DIR}")
    target_link_options(aa_wireless_recovery_test PRIVATE -Wl,--wrap=fsync -Wl,--wrap=renameat)
    target_compile_options(aa_wireless_recovery_test PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Werror)
    add_dependencies(aa_wireless_recovery_test aa-system-helper)
    foreach(case R01 R02 R03 R04 R10 ApOnly)
        add_test(NAME wireless_recovery_${case} COMMAND aa_wireless_recovery_test --gtest_filter=WirelessRecovery.${case}*)
        set_tests_properties(wireless_recovery_${case} PROPERTIES TIMEOUT 30 RESOURCE_LOCK aa_wireless_composed)
    endforeach()
    foreach(case R05 R06)
        add_test(NAME wireless_recovery_${case} COMMAND aa_wireless_recovery_test --gtest_filter=WirelessRecoveryProcess.${case}*)
        set_tests_properties(wireless_recovery_${case} PROPERTIES TIMEOUT 40 RESOURCE_LOCK aa_wireless_composed)
    endforeach()
    add_test(NAME wireless_recovery_R07 COMMAND aa_wireless_recovery_test --gtest_filter=WirelessRecoveryKill.R07*)
    add_test(NAME wireless_recovery_R09 COMMAND aa_wireless_recovery_test --gtest_filter=WirelessRecoveryConsumer.R09*)
    set_tests_properties(wireless_recovery_R07 wireless_recovery_R09 PROPERTIES TIMEOUT 45 RESOURCE_LOCK aa_wireless_composed)
    foreach(case R08 R11)
        add_test(NAME wireless_recovery_${case} COMMAND "${CMAKE_COMMAND}" -E env "GTEST_FILTER=WirelessRecoveryActive.${case}*" "${Python3_EXECUTABLE}" -B
            "${CMAKE_SOURCE_DIR}/tests/transport/tls_run.py" "${CMAKE_SOURCE_DIR}" "$<TARGET_FILE:aa_wireless_recovery_test>")
        set_tests_properties(wireless_recovery_${case} PROPERTIES TIMEOUT 50 RESOURCE_LOCK aa_wireless_composed)
    endforeach()
    add_test(NAME wireless_recovery_qa_gates COMMAND "${Python3_EXECUTABLE}" -B
        "${CMAKE_SOURCE_DIR}/tests/wireless_recovery/test_recovery_qa_gates.py"
        "${CMAKE_SOURCE_DIR}/tools/wireless-qa/wireless_recovery_qa.py")
    set_tests_properties(wireless_recovery_qa_gates PROPERTIES TIMEOUT 30)
endif()
