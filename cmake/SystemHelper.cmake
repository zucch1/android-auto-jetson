        -Wl,--wrap=g_dbus_connection_new_finish -Wl,--wrap=g_dbus_connection_close_finish
        -Wl,--wrap=g_socket_new_from_fd)
    add_test(NAME bluez_startup_contract COMMAND dbus-run-session -- $<TARGET_FILE:aa_bluez_startup_test>)
    set_tests_properties(bluez_startup_contract PROPERTIES TIMEOUT 20)
    add_test(NAME system_helper_cross_smoke_configuration COMMAND "${CMAKE_COMMAND}"
        -DCMAKE_CROSSCOMPILING=TRUE -DCMAKE_DISABLE_FIND_PACKAGE_OpenSSL=TRUE
        -P "${CMAKE_SOURCE_DIR}/cmake/SystemHelper.cmake")
endif()
