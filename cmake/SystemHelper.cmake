    add_executable(aa_bluez_startup_test tests/helper/bluez_startup_test.cpp)
    target_link_libraries(aa_bluez_startup_test PRIVATE aa_system_helper PkgConfig::AA_GIO GTest::gtest_main)
    set_target_properties(aa_bluez_startup_test PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES)
    target_compile_options(aa_bluez_startup_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
    target_link_options(aa_bluez_startup_test PRIVATE
