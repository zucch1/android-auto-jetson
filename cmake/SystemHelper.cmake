if(CMAKE_CROSSCOMPILING)
    message(STATUS "System helper qualification unavailable in cross-smoke mode")
    return()
endif()
find_package(OpenSSL REQUIRED COMPONENTS Crypto)
find_package(PkgConfig REQUIRED)
pkg_check_modules(AA_GIO REQUIRED IMPORTED_TARGET gio-2.0 gio-unix-2.0)
add_library(aa_system_helper STATIC
    src/helper/Identity.cpp src/helper/SystemHelper.cpp src/helper/BusService.cpp
    src/helper/BusClient.cpp src/helper/crypto_adapter/Crypto.cpp
    src/helper/bluez_adapter/Platform.cpp src/helper/bluez_adapter/Peers.cpp
    src/helper/bluez_adapter/Callbacks.cpp src/helper/bluez_adapter/Startup.cpp
    src/helper/nm/Files.cpp src/helper/nm/Commands.cpp src/helper/nm/Connection.cpp src/helper/nm/Backend.cpp)
target_include_directories(aa_system_helper PUBLIC "${CMAKE_SOURCE_DIR}/include")
target_link_libraries(aa_system_helper PUBLIC aa_ipc_dbus aa_trust OpenSSL::Crypto)
target_link_libraries(aa_system_helper PUBLIC PkgConfig::AA_GIO)
add_executable(aa-system-helper src/helper/main.cpp)
target_link_libraries(aa-system-helper PRIVATE aa_system_helper)
foreach(target aa_system_helper aa-system-helper)
    set_target_properties(${target} PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Werror)
endforeach()
if(NOT CMAKE_CROSSCOMPILING)
    add_executable(aa_nm_startup_test tests/helper/nm_startup_test.cpp)
    target_link_libraries(aa_nm_startup_test PRIVATE aa_system_helper GTest::gtest)
    target_compile_definitions(aa_nm_startup_test PRIVATE AA_HELPER_BUILD="${CMAKE_BINARY_DIR}")
    set_target_properties(aa_nm_startup_test PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES)
    target_compile_options(aa_nm_startup_test PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Werror)
    add_test(NAME system_helper_nm_startup_private_bus COMMAND aa_nm_startup_test)
    set_tests_properties(system_helper_nm_startup_private_bus PROPERTIES TIMEOUT 15)
    add_executable(aa_nm_ap_test tests/helper/nm_test.cpp tests/trust/syscall_faults.cpp)
    target_link_options(aa_nm_ap_test PRIVATE -Wl,--wrap=fsync -Wl,--wrap=renameat)
    target_link_libraries(aa_nm_ap_test PRIVATE aa_system_helper GTest::gtest_main PkgConfig::AA_GIO)
    target_compile_definitions(aa_nm_ap_test PRIVATE AA_HELPER_BUILD="${CMAKE_BINARY_DIR}" AA_HELPER_SOURCE="${CMAKE_SOURCE_DIR}")
    set_target_properties(aa_nm_ap_test PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES)
    target_compile_options(aa_nm_ap_test PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Werror)
    add_dependencies(aa_nm_ap_test aa-system-helper)
    add_test(NAME system_helper_nm_ap_private_bus COMMAND aa_nm_ap_test)
    set_tests_properties(system_helper_nm_ap_private_bus PROPERTIES TIMEOUT 90)
    add_executable(aa_system_helper_test tests/helper/core_test.cpp tests/helper/identity_test.cpp
        tests/helper/confirmation_test.cpp tests/helper/retirement_test.cpp tests/helper/schema_test.cpp tests/trust/syscall_faults.cpp)
    target_compile_definitions(aa_system_helper_test PRIVATE AA_HELPER_SOURCE="${CMAKE_SOURCE_DIR}")
    target_link_options(aa_system_helper_test PRIVATE -Wl,--wrap=fsync -Wl,--wrap=renameat)
    target_link_libraries(aa_system_helper_test PRIVATE aa_system_helper GTest::gtest_main)
    set_target_properties(aa_system_helper_test PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES)
    add_test(NAME system_helper_unit COMMAND aa_system_helper_test)
    set_tests_properties(system_helper_unit PROPERTIES TIMEOUT 60)
    add_executable(aa_system_helper_fixture tests/helper/fixture.cpp tests/trust/syscall_faults.cpp)
    target_link_libraries(aa_system_helper_fixture PRIVATE aa_system_helper)
    target_link_options(aa_system_helper_fixture PRIVATE -Wl,--wrap=fsync -Wl,--wrap=renameat)
    add_executable(aa_bluez_peer_probe tests/helper/peer_probe.cpp)
    target_link_libraries(aa_bluez_peer_probe PRIVATE aa_system_helper)
    add_executable(aa_system_helper_bus_test tests/helper/bus_test.cpp)
    target_link_libraries(aa_system_helper_bus_test PRIVATE aa_system_helper GTest::gtest_main)
    foreach(target aa_system_helper_fixture aa_system_helper_bus_test aa_bluez_peer_probe)
        set_target_properties(${target} PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES)
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
