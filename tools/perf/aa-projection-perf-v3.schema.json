{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zucch1/android-auto-jetson/tools/perf/aa-projection-perf-v3.schema.json",
  "title": "Wired active-window measurement result v3 (signed A/V contract, moving-map workload)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task",
    "generated_at_utc",
    "mode",
    "duration_seconds",
    "verdict",
    "crashes",
    "budgets",
    "metrics",
    "thermal_state",
    "measurement_coverage",
    "violations",
    "provenance",
    "notes",
    "measurement_origin",
    "qualification_status",
    "named_gaps",
    "provenance_gaps",
    "invalid_telemetry",
    "run_status",
    "build",
    "av_contract",
    "workload"
  ],
  "properties": {
    "schema": {
      "const": "aa-projection-perf/3"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "wired",
        "wireless"
      ]
    },
    "duration_requested": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "measurement_origin": {
      "enum": [
        "live",
        "offline"
      ]
    },
    "qualification_status": {
      "enum": [
        "COMPLETE_LIVE",
        "OFFLINE_ONLY",
        "INCOMPLETE"
      ]
    },
    "named_gaps": {
      "$ref": "#/$defs/strings"
    },
    "provenance_gaps": {
      "$ref": "#/$defs/strings"
    },
    "invalid_telemetry": {
      "$ref": "#/$defs/strings"
    },
    "run_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "early_exit": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "receiver_exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "receiver_stopped_by_collector": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "display_survived": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "display_exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "display_connected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "active_projection_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "startup_wait_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "projection_failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "interference": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "terminal_errors": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object"
          }
        },
        "startup_ms": {
          "$ref": "#/$defs/bound"
        },
        "video_units": {
          "$ref": "#/$defs/bound"
        },
        "audio_chunks": {
          "$ref": "#/$defs/bound"
        },
        "concurrent_builds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "t_s",
              "processes"
            ],
            "properties": {
              "t_s": {
                "type": "number"
              },
              "processes": {
                "$ref": "#/$defs/strings"
              }
            }
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "blocked_on": {
      "type": [
        "string",
        "null"
      ]
    },
    "crashes": {
      "$ref": "#/$defs/count"
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metric"
      },
      "properties": {
        "audio_catch_up_events": {
          "allOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "properties": {
                "unit": {
                  "const": "events"
                },
                "gated": {
                  "const": false
                },
                "status": {
                  "const": "INFORMATIONAL"
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          ]
        },
        "audio_catch_up_frames": {
          "allOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "properties": {
                "unit": {
                  "const": "frames"
                },
                "gated": {
                  "const": false
                },
                "status": {
                  "const": "INFORMATIONAL"
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          ]
        },
        "audio_catch_up_ms": {
          "allOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "properties": {
                "unit": {
                  "const": "ms"
                },
                "gated": {
                  "const": false
                },
                "status": {
                  "const": "INFORMATIONAL"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          ]
        }
      },
      "required": [
        "receiver_rss_peak_mb",
        "receiver_rss_mean_mb",
        "receiver_cpu_sustained_pct_one_core",
        "receiver_cpu_peak_pct_one_core",
        "rss_growth_pct",
        "av_sync_ms",
        "audio_latency_ms",
        "audio_scheduling_skew_ms",
        "helper_rss_mb",
        "frame_drops",
        "decode_p50_ms",
        "decode_p95_ms",
        "decode_fps",
        "decode_frames",
        "ipc_throughput_mbps",
        "ipc_p95_added_latency_ms",
        "thermal_peak_c",
        "av_window_mean_abs_ms",
        "av_p99_abs_ms",
        "av_max_abs_ms",
        "av_excursions",
        "av_hard_cap_pairs",
        "av_coverage_pct"
      ]
    },
    "thermal_state": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "peak_c",
        "zones"
      ],
      "properties": {
        "peak_c": {
          "type": "number"
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zone",
              "temp_c"
            ],
            "properties": {
              "zone": {
                "type": "string",
                "minLength": 1
              },
              "temp_c": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "measurement_coverage": {
      "$ref": "#/$defs/coverage"
    },
    "thermal_policy": {
      "$ref": "#/$defs/coverage/properties/thermal_scope/properties/policy"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "value",
          "budget_max",
          "detail"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "budget_max": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "notes": {
      "$ref": "#/$defs/strings"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_type",
        "build_dir",
        "allow_unoptimized_build",
        "verified_on",
        "non_qualifying"
      ],
      "properties": {
        "build_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "allow_unoptimized_build": {
          "type": "boolean"
        },
        "verified_on": {
          "enum": [
            "target",
            "host",
            "none"
          ]
        },
        "non_qualifying": {
          "type": [
            "string",
            "null"
          ]
        },
        "binaries": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "av_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limits",
        "valid",
        "passed"
      ],
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window_s",
            "window_mean_abs_ms",
            "p99_abs_ms",
            "excursion_ms",
            "excursions_per_s",
            "excursion_period_s",
            "hard_cap_ms",
            "coverage_min"
          ],
          "properties": {
            "window_s": {
              "const": 5
            },
            "window_mean_abs_ms": {
              "const": 40.0
            },
            "p99_abs_ms": {
              "const": 50.0
            },
            "excursion_ms": {
              "const": 90.0
            },
            "excursions_per_s": {
              "const": 0.0005555555555555556
            },
            "excursion_period_s": {
              "const": 1800
            },
            "hard_cap_ms": {
              "const": 150.0
            },
            "coverage_min": {
              "const": 0.9
            }
          }
        },
        "valid": {
          "type": "boolean"
        },
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "clauses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "window_mean",
            "p99_abs",
            "excursions",
            "hard_cap"
          ],
          "properties": {
            "coverage": {
              "type": "boolean"
            },
            "window_mean": {
              "type": "boolean"
            },
            "p99_abs": {
              "type": "boolean"
            },
            "excursions": {
              "type": "boolean"
            },
            "hard_cap": {
              "type": "boolean"
            }
          }
        },
        "pairs": {
          "$ref": "#/$defs/count"
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "over_50_ms": {
          "$ref": "#/$defs/count"
        },
        "signed_p1_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "signed_p50_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "signed_p99_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "signed_min_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "signed_max_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "abs_p99_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "abs_max_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "window_mean_min_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "window_mean_max_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "worst_window_mean_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_clause": {
          "const": "soak_rate"
        },
        "excursions": {
          "$ref": "#/$defs/count"
        },
        "excursion_allowance": {
          "$ref": "#/$defs/count"
        },
        "over_hard_cap": {
          "$ref": "#/$defs/count"
        },
        "excursion_pairs_truncated": {
          "type": "boolean"
        },
        "excursion_pairs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offset_s",
              "skew_ms"
            ],
            "properties": {
              "offset_s": {
                "type": "number",
                "minimum": 0
              },
              "skew_ms": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "workload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "media_relaunches",
            "drags",
            "stimulus_started",
            "phone_failure",
            "max_drag_gap_s",
            "cleanup_failures"
          ],
          "properties": {
            "kind": {
              "const": "moving-map"
            },
            "media_relaunches": {
              "$ref": "#/$defs/count"
            },
            "drags": {
              "$ref": "#/$defs/count"
            },
            "stimulus_started": {
              "type": "boolean"
            },
            "phone_failure": {
              "type": [
                "string",
                "null"
              ]
            },
            "max_drag_gap_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "cleanup_failures": {
              "$ref": "#/$defs/strings"
            }
          }
        }
      ]
    },
    "link": {
      "$ref": "#/$defs/wireless_link"
    },
    "ap_interface": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "ap_channel": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        36,
        40,
        44,
        48,
        null
      ]
    },
    "startup_basis": {
      "enum": [
        "receiver",
        "harness_launch_to_active"
      ]
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "bound": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiver_rss_mb_max",
        "receiver_cpu_pct_one_core_max",
        "av_window_mean_abs_ms_max",
        "av_p99_abs_ms_max",
        "av_excursion_ms",
        "av_excursions_per_s",
        "av_hard_cap_ms",
        "av_coverage_pct_min",
        "audio_latency_ms_max",
        "rss_growth_pct_max",
        "crashes_max",
        "helper_rss_mb_max"
      ],
      "properties": {
        "receiver_rss_mb_max": {
          "const": 250.0
        },
        "receiver_cpu_pct_one_core_max": {
          "const": 50.0
        },
        "audio_latency_ms_max": {
          "const": 200.0
        },
        "rss_growth_pct_max": {
          "const": 10.0
        },
        "crashes_max": {
          "const": 0
        },
        "helper_rss_mb_max": {
          "const": 32.0
        },
        "av_window_mean_abs_ms_max": {
          "const": 40.0
        },
        "av_p99_abs_ms_max": {
          "const": 50.0
        },
        "av_coverage_pct_min": {
          "const": 90.0
        },
        "av_excursion_ms": {
          "const": 90.0
        },
        "av_excursions_per_s": {
          "const": 0.0005555555555555556
        },
        "av_hard_cap_ms": {
          "const": 150.0
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "gated",
        "status"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "budget_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "op": {
          "enum": [
            "le",
            "lt",
            "ge"
          ]
        },
        "gated": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INFORMATIONAL",
            "NOT_REQUIRED",
            "UNAVAILABLE"
          ]
        },
        "note": {
          "type": "string"
        },
        "budget_min": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_digest",
        "build_artifact_digest",
        "configuration_digest",
        "service_definitions",
        "dependency_versions",
        "target_hardware_state",
        "package_digest",
        "equivalence_status"
      ],
      "properties": {
        "source_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_artifact_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "digest"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "dependency_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "target_hardware_state": {
          "type": "object"
        },
        "package_digest": {
          "const": null
        },
        "equivalence_status": {
          "const": "provisional"
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "first_ns",
        "last_ns",
        "max_gap_ns"
      ],
      "properties": {
        "count": {
          "$ref": "#/$defs/count"
        },
        "first_ns": {
          "$ref": "#/$defs/bound"
        },
        "last_ns": {
          "$ref": "#/$defs/bound"
        },
        "max_gap_ns": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "valid",
        "missing",
        "first_ns",
        "last_ns",
        "max_gap_ns"
      ],
      "properties": {
        "expected": {
          "$ref": "#/$defs/count"
        },
        "valid": {
          "$ref": "#/$defs/count"
        },
        "missing": {
          "$ref": "#/$defs/count"
        },
        "first_ns": {
          "$ref": "#/$defs/bound"
        },
        "last_ns": {
          "$ref": "#/$defs/bound"
        },
        "max_gap_ns": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "valid",
        "missing",
        "first_ns",
        "last_ns",
        "max_gap_ns",
        "baseline_valid",
        "measured_interval_ns"
      ],
      "properties": {
        "expected": {
          "$ref": "#/$defs/count"
        },
        "valid": {
          "$ref": "#/$defs/count"
        },
        "missing": {
          "$ref": "#/$defs/count"
        },
        "first_ns": {
          "$ref": "#/$defs/bound"
        },
        "last_ns": {
          "$ref": "#/$defs/bound"
        },
        "max_gap_ns": {
          "$ref": "#/$defs/count"
        },
        "baseline_valid": {
          "type": "boolean"
        },
        "measured_interval_ns": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "first_ns",
        "last_ns",
        "max_gap_ns",
        "begin_ns",
        "bytes"
      ],
      "properties": {
        "count": {
          "$ref": "#/$defs/count"
        },
        "first_ns": {
          "$ref": "#/$defs/bound"
        },
        "last_ns": {
          "$ref": "#/$defs/bound"
        },
        "max_gap_ns": {
          "$ref": "#/$defs/count"
        },
        "begin_ns": {
          "$ref": "#/$defs/bound"
        },
        "bytes": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "window",
        "sampling",
        "rss",
        "cpu",
        "thermal",
        "ipc_consumption",
        "ipc_matches",
        "decode",
        "quantiles"
      ],
      "properties": {
        "policy": {
          "enum": [
            "active-window-coverage/1",
            "active-window-coverage/orin-nano-cv-unavailable/1"
          ]
        },
        "thermal_scope": {
